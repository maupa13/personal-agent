[Unit]
Description=Private API CONNECT proxy for VPS1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vps-egress-proxy
Group=vps-egress-proxy
RuntimeDirectory=vps-egress-proxy
ExecStart=/opt/vps-egress/vendor/usr/bin/tinyproxy -d -c /opt/vps-egress/config/tinyproxy.conf
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
