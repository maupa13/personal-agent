FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt requirements.server.txt /tmp/
RUN apt-get update \
 && apt-get install -y --no-install-recommends fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/* \
 && python -m pip install --no-cache-dir -r /tmp/requirements.server.txt
COPY app /app
RUN mkdir -p /data \
 && groupadd --gid 10001 rpa \
 && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin rpa \
 && chown -R rpa:rpa /app /data
USER rpa
EXPOSE 8080
CMD ["python","/app/main.py"]
