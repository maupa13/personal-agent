{
  "product": "Personal Agent Rus",
  "product_family": "Personal Agent",
  "core_product": "Personal Agent Core",
  "edition": "rus",
  "locale": "ru-RU",
  "slug": "personal-agent-rus",
  "version": "0.7.1",
  "distribution": "docker-first-browser-first",
  "user_surface": "http://127.0.0.1:3100/",
  "admin_surface": "http://127.0.0.1:3100/admin",
  "milestone": "orchestrator-task-engine-vps-deployment-monitoring-foundation",
  "canonical_spec": "docs/specification/MASTER-SPEC.md",
  "bootstrap_model": {
    "purpose": "smoke_and_fallback_only",
    "default": "qwen3:0.6b",
    "visible_to_user": false,
    "delivery": "lifecycle_on_first_start"
  },
  "model_selection": "admin_only_provider_registry",
  "persistent_volumes": [
    "par-rus-data",
    "par-rus-models",
    "par-rus-code-ipc"
  ],
  "runtime_services": [
    "ollama",
    "searxng",
    "browser",
    "code-worker",
    "core"
  ],
  "capabilities": {
    "chat": "ready",
    "auth": "ready",
    "provider_registry": "ready",
    "web.search": "ready",
    "web.fetch": "ready",
    "browser.navigate": "ready",
    "research.basic": "ready",
    "files": "ready",
    "code": "ready",
    "image": "planned",
    "audio": "planned",
    "video": "planned",
    "automation": "planned",
    "file.read": "ready",
    "file.write": "ready",
    "artifact.manager": "ready",
    "billing": "ready",
    "usage.metering": "ready",
    "payment.adapter.yookassa": "ready-config-required",
    "orchestrator": "ready",
    "task.research_report": "ready",
    "deployment.vps": "ready-config-required-live-gate",
    "monitoring": "ready",
    "lan": "ready",
    "deployment.bootstrap": "ready-debian-ubuntu-root",
    "deployment.provider_bootstrap": "ready-external-provider-only",
    "security.csrf": "ready-accounts-mode"
  },
  "web": {
    "search_provider": "searxng",
    "browser_worker": "playwright",
    "ssrf_policy": "public_http_https_only",
    "source_evidence_required": true,
    "live_canary": "DTF"
  },
  "ui_contract": {
    "asset_cache": "no-store",
    "asset_version": "0.7.1",
    "history": "browser-local-foundation",
    "admin_entry": "authenticated",
    "source_cards": true
  },
  "package_policy": {
    "user_verify": "signed manifest files; local generated extras ignored",
    "release_verify": "generated Python cache artifacts forbidden"
  },
  "release_gate": {
    "required": [
      "static",
      "windows-command-contract",
      "api",
      "browser-desktop",
      "browser-mobile",
      "admin",
      "providers",
      "auth",
      "web-deterministic",
      "research-deterministic",
      "ssrf",
      "prompt-injection-boundary",
      "persistence",
      "backend-failure",
      "concurrency",
      "xss",
      "files-eight-formats",
      "artifact-validation",
      "file-context",
      "file-user-isolation",
      "upload-security",
      "code-python",
      "code-java",
      "code-powershell-contract",
      "code-timeout",
      "code-cancel",
      "code-output-limit",
      "code-secret-isolation",
      "code-user-isolation",
      "code-ui",
      "orchestrator-task-engine",
      "research-report-artifacts",
      "deployment-bundle",
      "deployment-bootstrap",
      "deployment-public-hot-verify",
      "deployment-provider-bootstrap",
      "csrf-accounts-mode",
      "monitoring",
      "lan-contract"
    ],
    "environment_bound": [
      "live-browser-reference-windows",
      "web-live-canary-DTF",
      "restart-repair-stopstart-reference-windows",
      "windows-reboot",
      "clean-machine",
      "real-vps-ssh-dns-https-provider-chat",
      "physical-lan-device"
    ]
  },
  "windows_installer": "planned_thin_wrapper_over_same_runtime",
  "files": {
    "formats": [
      "txt",
      "md",
      "json",
      "csv",
      "pdf",
      "docx",
      "xlsx",
      "pptx"
    ],
    "workspace": "per-user",
    "artifact_validation": "parser-reopen+sha256",
    "max_upload_bytes": 20971520,
    "ocr": "planned",
    "security": [
      "path-normalization",
      "office-container-zip-slip-check",
      "size-limit",
      "user-isolation"
    ]
  },
  "runtime": {
    "code_worker": "isolated-docker-no-network"
  },
  "code": {
    "worker": "isolated",
    "transport": "unix-domain-socket",
    "network": "disabled",
    "languages": [
      "python",
      "java",
      "powershell"
    ],
    "security": [
      "read-only-root",
      "bounded-cpu",
      "bounded-memory",
      "bounded-pids",
      "bounded-output",
      "hard-timeout",
      "process-group-cancel",
      "secret-env-scrub"
    ]
  },
  "billing": {
    "plans": {
      "LIGHT": 0,
      "MEDIUM": 500,
      "PRO": 1000
    },
    "currency": "RUB",
    "period": "monthly",
    "local_inference": "unlimited-monitored",
    "platform_remote": "quota-and-cost-controlled",
    "byok": "metered-separately",
    "admin": "commercially-unrestricted-monitored",
    "user_token_display": "opt-in",
    "payment_adapter": "yookassa",
    "live_configuration_required": true
  },
  "deployment": {
    "profiles": {
      "local": "full-local-docker",
      "server-lite": "core+https+remote-api",
      "server-standard": "core+https+extensible-workers",
      "edge": "planned-outbound-worker"
    },
    "ssh_auth": [
      "password",
      "private_key"
    ],
    "host_key_verification": "sha256-fingerprint-required",
    "staged_release": true,
    "hot_verify": [
      "internal-core-health",
      "public-https-exact-version"
    ],
    "rollback": true,
    "credentials_persisted": false,
    "reverse_proxy": "caddy:2.11.2",
    "authentication": [
      "ssh-password-ephemeral",
      "ssh-private-key-ephemeral"
    ],
    "host_key": "sha256-pinned-required",
    "fresh_vps_bootstrap": "debian-ubuntu-root-distribution-packages",
    "provider_bootstrap": "optional-existing-external-provider-over-public-https",
    "release_roots": {
      "root": "/opt/personal-agent",
      "non_root": "$HOME/.local/share/personal-agent"
    }
  },
  "orchestrator": {
    "states": [
      "CREATED",
      "PLANNING",
      "QUEUED",
      "RUNNING",
      "VERIFYING",
      "COMPLETED",
      "FAILED",
      "CANCELLED"
    ],
    "durable_steps": true,
    "events": "SSE+JSON",
    "restart_resume": "idempotent-completed-step-skip",
    "task_types": [
      "research_report"
    ]
  },
  "monitoring": {
    "admin_snapshot": true,
    "weak_vps_mode": "built-in-lightweight",
    "prometheus_stack": "planned-optional"
  },
  "lan": {
    "windows_enable_disable": true,
    "bind": "PA_BIND_IP",
    "firewall_profile": "Private",
    "secure_context_note": true
  }
}
