# Personal Agent Rus v0.8.0-alpha.8
PA_BIND_IP=127.0.0.1
PA_UI_PORT=3100
PA_ADMIN_TOKEN=CHANGE_ME
PA_SEARXNG_SECRET=CHANGE_ME
PA_BOOTSTRAP_MODEL=qwen3:0.6b
PA_OLLAMA_IMAGE=ollama/ollama:0.32.6
PA_CORE_IMAGE=personal-agent-core:0.8.0-alpha.8
PA_BROWSER_IMAGE=personal-agent-browser:0.8.0-alpha.8
PA_CODE_WORKER_IMAGE=personal-agent-code-worker:0.8.0-alpha.8
PA_CODE_MAX_SOURCE_BYTES=262144
PA_CODE_MAX_OUTPUT_BYTES=1048576
PA_CODE_MAX_TIMEOUT_SECONDS=30
PA_SEARXNG_IMAGE=searxng/searxng:2026.8.5-1689cb1b5

# Core runtime paths and public identity
PA_RUNTIME_PROFILE=local
PA_VERSION=1.0.3
PA_AUTH_MODE=personal
PA_REGISTRATION_POLICY=open
PA_SECURE_COOKIES=0
PA_PUBLIC_URL=
PA_PUBLIC_DOMAIN=localhost

# Email verification and password recovery. Leave PA_SMTP_HOST empty for local-link dev mode.
PA_EMAIL_VERIFICATION_REQUIRED=0
PA_EMAIL_VERIFICATION_TTL_SECONDS=86400
PA_PASSWORD_RESET_TTL_SECONDS=7200
PA_SMTP_HOST=
PA_SMTP_PORT=587
PA_SMTP_USERNAME=
PA_SMTP_PASSWORD=
PA_SMTP_FROM=
PA_SMTP_STARTTLS=1
PA_SMTP_USE_SSL=0

# Optional PostgreSQL runtime. Empty keeps the default SQLite database.
PA_DATABASE_URL=
PA_POSTGRES_DB=personal_agent
PA_POSTGRES_USER=personal_agent
PA_POSTGRES_PASSWORD=

# Optional LAN and selective VPN routing. The VPN profile must be installed separately.
# Do not put a vpn:// secret in this file; save it from Admin -> Deployment -> VPN routing.
PA_LAN_ENABLED=0
PA_LAN_PUBLIC_URL=
PA_VPN_ROUTING_ENABLED=0
PA_VPN_ROUTING_MODE=
PA_VPN_PREFERENCE_ID=
PA_VPN_VPS2_HOST=
PA_VPN_UPSTREAM_HOST=
PA_VPN_UPSTREAM_IP=
PA_VPN_ALLOWED_IPS=
PA_VPN_PROFILE_FILE=
PA_VPN_IMPORT_URI_FILE=/data/secrets/amnezia-import.vpnuri
PA_VPN_INTERFACE=wg0
PA_VPN_VPS1_ADDRESS=10.10.0.2/24
PA_VPN_SUBNET=10.10.0.0/24
PA_VPN_ENDPOINT_PORT=51820
PA_VPN_NAT_INTERFACE=eth0
PA_VPN_UPSTREAM_NAME=OpenAPI

# Payment provider is configured and stored from Admin, not in this file.
# Admin path: Subscriptions and Usage -> YooKassa.
